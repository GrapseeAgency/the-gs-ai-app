# Generated by XcodeGen in CI — never commit the project file
*.xcodeproj

# The native engine, downloaded from the ios-native run's GsFfi.xcframework
# artifact. It is a compiled binary: source only in git, on every platform.
# project.yml references this path, so the directory is expected to exist --
# it just must never be committed. `ios-native` builds it on a macOS runner,
# which a contributor on Linux cannot do.
Frameworks/
*.xcframework

# Xcode / SwiftPM build artifacts
DerivedData/
.build/

# User-specific Xcode state
xcuserdata/
*.xcuserstate

# macOS noise
.DS_Store
