// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- GS AI platform models (Task 6-g) ----
// NOTE: SQLite datasource — no primitive array fields; list values are stored as JSON strings.

model UserDevice {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model Conversation {
  id           String    @id @default(cuid())
  title        String    @default("New chat")
  modelId      String?
  assistantId  String?
  pinned       Boolean   @default(false)
  archived     Boolean   @default(false)
  folder       String?
  userDeviceId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
  attachments  Attachment[]
  assistant    Assistant? @relation(fields: [assistantId], references: [id])

  @@index([updatedAt])
  @@index([assistantId])
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime        @default(now())
  attachments    Attachment[]
  sources        MessageSource[]
  // PHASE 8.1 — when this turn was an ambiguity clarification (§6), the
  // native quick choices persist here (JSON: {question, options:[{id,label}]}).
  clarifyOptions String?

  @@index([conversationId])
}

// PHASE 8 — real web search & grounded answers. Canonical source metadata for
// assistant messages whose answer was grounded in REAL web_search evidence.
// Only sources actually cited by the generated answer ([N] markers parsed
// server-side) are persisted; url/domain come from the search provider's
// response, never from model text — nothing here can be fabricated by the
// model. Old clients simply ignore the field (ignoreUnknownKeys / Codable).
model MessageSource {
  id            String   @id @default(cuid())
  messageId     String
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ordinal       Int // 1-based citation number the user sees
  title         String
  url           String
  domain        String
  snippet       String   @default("")
  publishedDate String? // provider-reported date, when present
  query         String // the search query that produced this source
  retrievedAt   DateTime @default(now())
  // PHASE 8.1 source-evidence object (§11):
  // retrieved = full page actually read; snippet_only = discovered but not
  // read (headline honesty); failed/skipped kept only in the live trace.
  status        String   @default("retrieved")
  // Whether the final answer actually cited this source ([N] parsed server-side).
  used          Boolean  @default(false)
  rank          Int?     // position in its engine's ranking

  @@index([messageId])
}

// PHASE 5 input & multimodal foundation — real attachment records.
// `storagePath` is server-private (relative path under uploads/); the public
// handle is `GET /api/v1/files/:id`. Kind is extensible: image | pdf | document
// shipped; audio | video | screenshot reserved for when a real processor exists.
model Attachment {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind           String
  displayName    String
  mimeType       String
  byteSize       Int
  storagePath    String
  width          Int?
  height         Int?
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([messageId])
}

model Assistant {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @default("")
  instructions String   @default("")
  category     String   @default("general")
  starters     String   @default("[]")
  published    Boolean  @default(false)
  favourite    Boolean  @default(false)
  uses         Int      @default(0)
  rating       Float    @default(0)
  createdAt    DateTime @default(now())
  conversations Conversation[]
}

model Project {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  instructions String   @default("")
  createdAt    DateTime @default(now())
}

model LibraryItem {
  id        String   @id @default(cuid())
  kind      String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
}

model NotificationItem {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---- EVAL INFRASTRUCTURE LAYER 1 — structured trace store (Phase 1) ----
// One row per turn, written by the messages route at the GS-CAP terminal
// points. This is the foundation for the eval suite, the CI gate and the
// production monitor: graders read these rows, never the console logs.
// SQLite has no primitive list fields — `domains`/`cited` ride as JSON strings.
model TurnTrace {
  id               String   @id @default(cuid())
  requestId        String
  conversationId   String
  messageId        String
  timestamp        DateTime @default(now())
  clientVersion    String
  backendRevision  String
  capability       String // CHAT | WEB | DEEP_RESEARCH | TIME | VISION | DOCUMENT
  trigger          String // explicit | recency | source_specific | none | stop_reuse | ...
  searchExecuted   Boolean
  researchExecuted Boolean
  evidenceCount    Int
  sourceCount      Int
  sourcesRead      Int // status === 'retrieved' among the turn's fresh sources
  sourcesFailed    Int // status === 'failed' among the turn's fresh sources
  domains          String // JSON string[] — distinct domains returned
  modelRoute       String // INTERNAL ONLY — never sent to a client
  finalStatus      String // done | error | clarify
  cited            String // JSON number[] — cited source ordinals
  latencyMs        Int
  errorType        String? // provider_429 | ssrf_block | parse_fail | provider_error | null
  silentFailures   String? // JSON string[] — silent-failure-gate violations; null/[] = clean turn
  // FLASH MODE (Phase 5) — the mode dimension of the turn.
  requestedMode    String  @default("flash") // flash | thinking | auto — as the client sent it
  effectiveMode    String  @default("flash") // flash | thinking — after overrides + model capability
  thinkingLatencyMs Int?   // TTFT of the thinking path (ms); null when flash or buffered
  modeNote         String? // GS-MODE-REMAP / flash-forced note; null = clean resolution

  @@index([conversationId])
  @@index([timestamp])
  @@map("turns")
}

// EVALUATION INFRASTRUCTURE — Layer 5 production monitoring (Phase 5).
// The hourly monitor samples a slice of live turns from `turns`, grades them
// with the SAME deterministic graders as the eval suite (src/lib/eval-grader
// semantics), and writes one row per (window, category). `passRate` is the
// honest production number; `wowDelta` compares against the same category's
// rate 7 days ago and `alerted` marks any drop > 5 percentage points.
model EvalScore {
  id            String   @id @default(cuid())
  windowStart   DateTime // UTC hour window this batch covers
  windowEnd     DateTime
  category      String   // ROUTING | CONTEXT_ISOLATION | SOURCE_QUALITY | FAILURE_HONESTY (monitor-gradable subsets)
  sampledTurns  Int      // turns sampled into this batch
  gradedTurns   Int      // turns that produced a verdict (excluded: ungradeable)
  passCount     Int
  failCount     Int
  passRate      Float    // passCount / gradedTurns, 0..1
  wowDelta      Float?   // passRate - passRate(same category, 7 days earlier), percentage points
  alerted       Boolean  @default(false) // true when wowDelta < -0.05
  alertNote     String?  // human-readable alert text persisted with the row
  sampleDetail  String   // JSON — per-turn {requestId, verdict, failures[]} for auditability
  createdAt     DateTime @default(now())

  @@unique([windowStart, category])
  @@index([windowStart])
  @@map("eval_scores")
}

// ---- TURN EXECUTION LAYER — detached runs (ADR-117 pattern) ----------------
// TWO identifiers, deliberately distinct:
//   id (runId)   — billing/correlation id. Stable across HITL interrupt +
//                  resumption. Every turn_events row references it.
//   streamId     — transport id. FRESH on every POST /api/v1/messages/start
//                  (including resumption POSTs). Used as the stream-broker
//                  key suffix (chat:run:{streamId}).
// status: queued | running | awaiting_approval | completed | failed |
//         killed | cancelled
model TurnRun {
  id                 String    @id // runId
  streamId           String    @unique // transport id of the CURRENT subscription window
  conversationId     String
  userMessageId      String?
  assistantMessageId String?
  status             String    @default("queued")
  finalStatus        String? // done | error | clarify — the SSE terminal contract
  error              String?
  attempts           Int       @default(0)
  leaseOwner         String? // worker instance holding this run (stuck-job recovery)
  leaseExpiresAt     DateTime?
  // JSON map: sha256(runId+seq+tool+args) -> result digest. Stable across
  // restarts so a retried side-effecting op is executed once.
  idempotencyKeys    String    @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([conversationId])
  @@map("turn_runs")
}

// Stream broker store (transport-level, invisible to the SSE contract).
// Redis is NOT available in this sandbox — the backend is SQLite with the
// SAME protocol semantics as Redis Streams (see src/lib/stream-broker.ts):
//   entryId "<ms>-<seq>" is the SSE id; Last-Event-ID = readAfter(cursor);
//   payload {"d": <chunk JSON>} is one chunk relayed verbatim;
//   payload {"end":"1","status":s} is the terminal marker,
//     s ∈ completed | error | killed | cancelled.
// bounded append (MAXLEN ~) + safety TTL (expiresAt) mirrored per entry.
model StreamChunk {
  seq       Int      @default(autoincrement()) @id
  streamKey String // chat:run:{streamId}
  entryId   String // "<ms>-<seq>"
  payload   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([streamKey, entryId])
  @@index([streamKey, seq])
  @@index([expiresAt])
  @@map("stream_chunks")
}

// DURABLE EXECUTION — event sourcing (durable-agents / DBOS Transact model).
// Every model call, tool call, and approval is appended BEFORE and AFTER it
// happens. Run state is a fold over this log; a killed run is reconciled
// from the dangling Requested-without-Completed pair.
model TurnEvent {
  seq       Int      @default(autoincrement()) @id
  runId     String
  eventType String // TurnStarted | LLMCallRequested | LLMCallCompleted |
  // LLMCallFailed | ToolCallRequested | ToolCallCompleted |
  // SearchRequested | SearchCompleted | SourceOpened | SourceRead |
  // SynthesisRequested | SynthesisCompleted | ApprovalRequested |
  // ApprovalDecided | RunReconciled | RunCompleted | RunFailed
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([runId, seq])
  @@map("turn_events")
}

// PHASE 3 — human-in-the-loop parking. A tool marked requires_approval
// parks the run (no thread held, no process alive) until decided.
model ApprovalRequest {
  id             String    @id @default(cuid())
  runId          String
  tool           String
  args           String    @default("{}")
  idempotencyKey String
  status         String    @default("pending") // pending | approved | denied
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  @@index([runId])
  @@map("approval_requests")
}

// PHASE 5 — persistent Research Ledger (dossier pattern): verified claims,
// contradictions, open gaps, and search branches for one run.
model ResearchLedgerRow {
  runId     String   @id
  ledger    String // JSON ResearchLedger
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("research_ledgers")
}

// PHASE 6 — async subagent dispatch: the supervisor launches a task and
// continues working; tasks maintain their own state across interactions.
model SubagentTask {
  id        String    @id @default(cuid())
  runId     String // supervisor run
  name      String
  url       String? // remote agent server (heterogeneous deployment); null = local executor
  graphId   String?
  input     String    @default("{}")
  status    String    @default("pending") // pending | running | done | failed | cancelled
  result    String?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([runId])
  @@map("subagent_tasks")
}

// PHASE 7 — Persistent Knowledge Graph (factorized memory). Fluid working
// context crystallizes into exact event snapshots: numbers and entities are
// preserved byte-exact, never summarized or paraphrased.
model KnowledgeNode {
  id             String   @id @default(cuid())
  conversationId String
  kind           String // claim | entity | value | snapshot
  nodeKey        String // normalized identity for dedupe
  text           String
  meta           String   @default("{}") // JSON: verbatim numbers, sourceId, seq...
  createdAt      DateTime @default(now())

  @@unique([conversationId, nodeKey])
  @@index([conversationId])
  @@map("knowledge_nodes")
}

// ---- BENCHMARK INFRASTRUCTURE (Phase 7) -------------------------------------
// One row per (run_id) result file produced by gs-bench. Mirror of the
// unified result schema (cli/main.py make_result). Provenance columns
// (gitCommit, datasetRevision, harnessVersion, dockerImageDigest,
// infrastructure) implement hard rule 4; failed/errored/skipped counts are
// the rollout-card columns — headline scores are reported WITH them because
// reporting-rule choices alone swing scores by up to 20.9 points.
// SQLite: no JSONB/JSON primitive — `infrastructure` rides as a JSON string;
// no TIMESTAMPTZ — startedAt/completedAt are DateTime (ISO-8601 in UTC).
model BenchmarkRun {
  runId             String   @id // uuid from the result file
  model             String
  benchmark         String
  benchmarkVersion  String? // benchmark config revision (suite file + commit)
  datasetRevision   String? // pinned sha/commit resolved at download time
  harness           String // inspect_ai | tau2 | swebench | ...
  harnessVersion    String?
  dockerImageDigest String?
  infrastructure    String   @default("{}") // JSON {cpu, ram_gb, timeout_s}
  startedAt         DateTime?
  completedAt       DateTime?
  nSamples          Int?
  metric            String?
  score             Float?
  scoreStderr       Float?
  scoreCiLo         Float?
  scoreCiHi         Float?
  gitCommit         String?
  rawLogUrl         String?
  costUsd           Float?
  failedCount       Int      @default(0)
  erroredCount      Int      @default(0)
  skippedCount      Int      @default(0)
  // Phase 8/9 columns: exploit gap (visible - heldout) and contamination
  // flag (CONTAMINATED | NOT-FLAGGED | NOT-MEASURED | INDETERMINATE).
  exploitRate       Float?
  contaminationFlag String?
  contaminationScore Float?
  status            String   @default("done") // done | BLOCKED | INCOMPLETE-CI
  rawReason         String? // raw blocker/error text when status != done
  createdAt         DateTime @default(now())

  @@index([model, benchmark, completedAt(sort: Desc)])
  @@map("benchmark_runs")
}
