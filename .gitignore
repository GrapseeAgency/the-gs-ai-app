# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/test/
prompt

server.log
# Skills directory
/skills/

# ---- Android ----
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.apk
!download/*.apk
!android/**/*.apk.idsig

# ---- iOS ----
ios/DerivedData/
ios/**/*.xcuserstate
ios/xcuserdata/
# Generated by XcodeGen in CI — never commit:
ios/GSApp.xcodeproj/

# ---- CI housekeeping ----
.Trash-*/
# Never commit toolchain archives (GitHub 100MB limit)
cmdline-tools.zip
*.zip

/db/vault.db
/db/vault.db-*

# PHASE 5 attachment storage (runtime user content — never committed)
/uploads/
.secrets/

# FORENSIC AUDIT [2]/[7] — out-of-project copies live outside the repo, but ignore any in-repo shadow
/home/z/.gs-vault/
tests/private-holdout.json
native/build/

# --- GS AI native runtime build artefacts --------------------------------
# Cargo workspace output. 377 MB of incremental artefacts otherwise.
native/target/
# Vendored third-party C/C++ trees (llama.cpp, stable-diffusion.cpp)
native/cpp/*/vendor/
# Compiled objects and shared libraries anywhere under native/
native/**/*.o
native/**/*.a
native/**/*.so
native/**/*.so.*
# Model weights and runtime caches. data/.gitignore keeps the .gitkeep files.
native/data/models/*
native/data/cache/*
# Benchmark harness scratch: a0d8a96 declared these output, not source.
.venv-bench/
gs_bench.egg-info/
tool-results/
__pycache__/
