<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night variant of the launch theme: the app's obsidian launch surface
         (Aeruo.Obsidian) with light system-bar icons — no white flash and no
         dark-icons-on-obsidian when the system boots the app in dark mode. -->
    <style name="Theme.TheGsAiApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gs_launch_background_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
