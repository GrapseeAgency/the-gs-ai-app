{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist/probe",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/lib/design/**/*",
    "src/lib/calc/**/*",
    "src/lib/widgets/prompt.ts",
    "src/components/**/*",
    "scripts/test-genui-pipeline.ts",
    "scripts/test-widget-catalogue.ts",
    "scripts/test-widget-render.ts"
  ]
}
