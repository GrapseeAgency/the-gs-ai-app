<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Connectivity monitor behind the offline banner (ChatsScreen) —
         normal-level, auto-granted, no prompt. Without it ConnectivityManager
         calls throw SecurityException on device. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The finished-reply notification (API 33+ asks at runtime — consent is
         collected by the Reply notifications switch in Settings, never
         unprompted). Harmless no-op below API 33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Do Not Disturb switch on Notifications & Alerts reads and sets the
         device's real interruption filter. Normal-level, but Android still
         requires the user to hand over policy access from system settings —
         the row sends them there rather than faking the state. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- BiometricPrompt.authenticate() throws SecurityException without this
         normal-level permission; nothing else merges it in because the build
         uses the framework API, not androidx.biometric. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice press-and-hold on the hero orb (SpeechRecognizer). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- GS LiveUpdate: resolve the system package-installer for self-updates. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".GSApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TheGsAiApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Home-screen quick actions (New chat / New image / Ask GS). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- GS LiveUpdate: serves the downloaded update APK to the installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <profileable
        android:shell="true"
        tools:targetApi="29" />
</application>

</manifest>
