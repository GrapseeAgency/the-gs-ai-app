// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- GS AI platform models (Task 6-g) ----
// NOTE: SQLite datasource — no primitive array fields; list values are stored as JSON strings.

model UserDevice {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model Conversation {
  id           String    @id @default(cuid())
  title        String    @default("New chat")
  modelId      String?
  assistantId  String?
  pinned       Boolean   @default(false)
  archived     Boolean   @default(false)
  folder       String?
  userDeviceId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
  attachments  Attachment[]
  assistant    Assistant? @relation(fields: [assistantId], references: [id])

  @@index([updatedAt])
  @@index([assistantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())
  attachments    Attachment[]

  @@index([conversationId])
}

// PHASE 5 input & multimodal foundation — real attachment records.
// `storagePath` is server-private (relative path under uploads/); the public
// handle is `GET /api/v1/files/:id`. Kind is extensible: image | pdf | document
// shipped; audio | video | screenshot reserved for when a real processor exists.
model Attachment {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind           String
  displayName    String
  mimeType       String
  byteSize       Int
  storagePath    String
  width          Int?
  height         Int?
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([messageId])
}

model Assistant {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @default("")
  instructions String   @default("")
  category     String   @default("general")
  starters     String   @default("[]")
  published    Boolean  @default(false)
  favourite    Boolean  @default(false)
  uses         Int      @default(0)
  rating       Float    @default(0)
  createdAt    DateTime @default(now())
  conversations Conversation[]
}

model Project {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  instructions String   @default("")
  createdAt    DateTime @default(now())
}

model LibraryItem {
  id        String   @id @default(cuid())
  kind      String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
}

model NotificationItem {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}