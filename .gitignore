# ---- iOS ----
ios/DerivedData/
ios/**/*.xcuserstate
ios/xcuserdata/
# Generated by XcodeGen in CI — never commit:
ios/GSApp.xcodeproj/

# ---- CI housekeeping ----
.Trash-*/
# Never commit toolchain archives (GitHub 100MB limit)
cmdline-tools.zip
*.zip

/db/vault.db
/db/vault.db-*

# PHASE 5 attachment storage (runtime user content — never committed)
/uploads/
.secrets/

# FORENSIC AUDIT [2]/[7] — out-of-project copies live outside the repo, but ignore any in-repo shadow
/home/z/.gs-vault/
tests/private-holdout.json
native/build/

# --- GS AI native runtime build artefacts --------------------------------
# Cargo workspace output. 377 MB of incremental artefacts otherwise.
native/target/
# Vendored third-party C/C++ trees (llama.cpp, stable-diffusion.cpp)
native/cpp/*/vendor/
# Compiled objects and shared libraries anywhere under native/
native/**/*.o
native/**/*.a
native/**/*.so
# The device job drops the cross-compiled libgs_ffi.so here so the APK packages a
# real library. It is a CI build artifact, never a source file.
android/app/src/main/jniLibs/
native/**/*.so
# The device job drops the cross-compiled libgs_ffi.so here so the APK packages a
# real library. It is a CI build artifact, never a source file.
android/app/src/main/jniLibs/.*
# Model weights and runtime caches. data/.gitignore keeps the .gitkeep files.
native/data/models/*
native/data/cache/*
# Benchmark harness scratch: a0d8a96 declared these output, not source.
.venv-bench/
gs_bench.egg-info/
tool-results/
__pycache__/

# Native prebuilts and model weights: built or downloaded in CI, never committed.
# A .gguf in git is a permanent 1.1 GB liability; the app downloads on consent.
native/prebuilts/
**/*.gguf
**/*.onnx

# Object files: cc writes these next to the source in a manual in-tree build.
*.o
*.obj

# Python bytecode from the lints in .github/scripts/. Not a build output to ship,
# and it appeared because the lints import each other while being run locally.
__pycache__/
*.pyc

# ------------------------------------------------------------------ binaries
# The project rule is: no .so, no .a, no .gguf, no traineddata, no __pycache__,
# no PNG fixtures. The first four were already guarded above -- native/**/*.so,
# native/**/*.a, **/*.gguf and __pycache__/ -- and the two below were not. Both
# gaps were found by PROBING, not by reading:
#
#     $ git check-ignore -q native/x.traineddata ; echo $?
#     1
#
# A tesseract traineddata file is 15-40 MB and there are several, so this is the
# most expensive of the unguarded types. The OCR fixture the device tests use is
# DRAWN AT RUN TIME by .github/scripts/make_invoice_png.py precisely so that no
# image needs committing -- which is the right pattern, and a missing ignore rule
# is what undoes it.
**/*.traineddata
*.traineddata

# QA screenshot dumps. download/ and upload/ hold operator- and agent-captured
# PNGs; there are about 25 of them on main and none is read by a test.
#
# NOT `*.png`. The app icon is a PNG that MUST be committed:
#     ios/App/Assets.xcassets/AppIcon.appiconset/AppIcon.png
# and a global rule would silently drop it from the next clone, which fails at
# build time with a missing-asset error naming neither the rule nor the icon.
download/*.png
upload/*.png
