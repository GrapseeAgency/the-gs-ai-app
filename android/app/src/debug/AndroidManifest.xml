<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-BUILD OVERRIDE, and only for the loopback cleartext that the
  instrumented network tests need.

  See src/debug/res/xml/network_security_config.xml for the full explanation and
  the run that found it (36770334063). The short version: with targetSdk 35 and no
  network security config, Android blocks cleartext, so `http://127.0.0.1:<port>`
  is refused by policy before a socket is opened, and the test server was never
  contacted at all.

  A debug manifest MERGES over the main one, so the app under test gets this and
  a release APK does not. Release keeps the platform default, which is right for a
  shipping app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
