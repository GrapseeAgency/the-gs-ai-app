  "workerPlaceholder": "__GS_WORKER_CONTRACT_LITERAL__",
  "template": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' blob:; worker-src blob:; frame-src 'self' data: blob:; connect-src 'none'; style-src 'unsafe-inline'\">\n<style>body{margin:0;font:12px system-ui;color:#e9ecef;background:#171325}header{padding:10px;color:#c5bcff;font-size:11px}#log{max-height:250px;overflow:auto;padding:10px;font:12px ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.err{color:#fca5a5}.in{color:#aaa}form{display:flex;gap:6px;padding:10px;align-items:center}input{flex:1;min-width:0;background:#252034;border:1px solid #62577b;border-radius:8px;color:inherit;padding:8px;font:inherit}button{background:#6c4cf6;border:0;border-radius:8px;color:white;padding:8px;cursor:pointer}#execution iframe{width:100%;height:210px;border:0;background:#faf7ff;color:#211338}#path{font:12px ui-monospace,monospace;padding:0 10px;color:#c5bcff}</style></head><body>\n<header>Local virtual filesystem — no OS shell or device files. JavaScript runs in a disposable, network-disabled worker.</header>\n<div id=\"log\" role=\"log\"></div><div id=\"path\"></div><form><input id=\"command\" aria-label=\"Terminal command\" autocomplete=\"off\" spellcheck=\"false\"><button type=\"submit\">Run</button><button id=\"reset\" type=\"button\">Reset session</button></form><div id=\"execution\"></div>\n<script>\nfunction escapeCodeDisplay(source) {\n    const displaySymbol = /\\p{Emoji}|[\\u200D\\u20E3\\uFE0E\\uFE0F\\u{E0020}-\\u{E007F}]/u;\n    return Array.from(source, char => {\n        const cp = char.codePointAt(0);\n        if (cp <= 0x7f || (!displaySymbol.test(char) && !(cp >= 0x1f000 && cp <= 0x1faff)))\n            return char;\n        return char.split('').map(unit => `\\\\u${unit.charCodeAt(0).toString(16).padStart(4, '0')}`).join('');\n    }).join('');\n}\n\n\nconst payload=JSON.parse(__GS_TERMINAL_PAYLOAD_LITERAL__);\nconst workerContract=JSON.parse(__GS_WORKER_CONTRACT_LITERAL__);\nconst log=document.getElementById('log'), input=document.getElementById('command'), execution=document.getElementById('execution');\nlet fs, cwd, history, historyIndex;\nfunction line(kind,text){const el=document.createElement('div');el.className=kind;el.textContent=escapeCodeDisplay(String(text));log.appendChild(el);while(log.children.length>120)log.firstElementChild.remove();log.scrollTop=log.scrollHeight;}\nfunction showPath(){document.getElementById('path').textContent=escapeCodeDisplay(cwd)+' $';}\nfunction reset(){fs=new Map([['/',true],['/home',true],['/home/guest',true],['/home/guest/README.md','This is an in-memory virtual filesystem. These are not your device files.']]);cwd='/home/guest';history=[];historyIndex=-1;log.replaceChildren();execution.replaceChildren();input.value='';showPath();line('sys','Local virtual session. Type help.');if(payload.welcome)line('sys','Provided welcome: '+payload.welcome);}\nfunction resolve(raw){let p=raw||cwd;if(p==='~')p='/home/guest';if(p.startsWith('~/'))p='/home/guest/'+p.slice(2);const stack=[];for(const part of (p.startsWith('/')?p:cwd+'/'+p).split('/')){if(!part||part==='.')continue;if(part==='..')stack.pop();else stack.push(part);}return '/'+stack.join('/');}\nfunction words(source){const result=[];let text='',quote='',escaped=false,started=false;for(const char of source){if(escaped){text+=char;escaped=false;started=true;}else if(char==='\\\\'&&quote!==\"'\"){escaped=true;started=true;}else if(quote){if(char===quote)quote='';else text+=char;}else if(char==='\"'||char===\"'\"){quote=char;started=true;}else if(/\\s/.test(char)){if(started){result.push(text);text='';started=false;}}else{text+=char;started=true;}}if(quote||escaped)throw Error('Incomplete quoted argument.');if(started)result.push(text);return result;}\nfunction requireName(args){if(args.length!==1||!args[0]||args[0].startsWith('-'))throw Error('One filename is required; shell flags are not supported.');const p=resolve(args[0]);const parent=p.slice(0,p.lastIndexOf('/'))||'/';if(fs.get(parent)!==true)throw Error('Parent directory does not exist: '+parent);return p;}\nfunction repl(source){return 'const A=Object.getPrototypeOf(async function(){}).constructor;let run;try{run=new A(\"console\",'+JSON.stringify('\"use strict\";return (\\n'+source+'\\n)')+');}catch(error){if(!(error instanceof SyntaxError))throw error;run=new A(\"console\",'+JSON.stringify('\"use strict\";\\n'+source)+');}return await run(console);';}\nfunction run(raw){const trimmed=raw.trim();if(!trimmed)return;history.unshift(raw);history=history.slice(0,40);historyIndex=-1;line('in',cwd+' $ '+raw);execution.replaceChildren();const match=/^(\\S+)(?:\\s+([\\s\\S]*))?$/.exec(trimmed), name=match[1], rest=match[2]||'';try{if(name==='js'){if(!rest)throw Error('JavaScript source required.');execution.replaceChildren();const frame=document.createElement('iframe');frame.title='JavaScript worker output';frame.setAttribute('sandbox','allow-scripts');frame.srcdoc=workerContract.template.replace(workerContract.sourcePlaceholder,()=>JSON.stringify(repl(rest)).replace(/</g,'\\\\u003c'));execution.appendChild(frame);line('sys','Actual JavaScript execution and status are shown below.');return;}\nconst args=words(rest);if(args.some(a=>['|','>','>>','&&',';'].includes(a)))throw Error('Pipes and shell operators are not supported; no OS command was executed.');\nswitch(name){case 'help':line('out','Virtual commands: help, clear, pwd, ls [dir], tree, cd [dir], cat file, touch file, mkdir dir, rm file, echo text, date, whoami. js <source> executes real JavaScript in a two-second worker. No Python, SQL, Bash, Node APIs or installed packages.');for(const command of (Array.isArray(payload.commands)?payload.commands.slice(0,12):[]))line('sys','Help metadata only: '+command.name+' — '+(command.description||''));break;\ncase 'clear':log.replaceChildren();break;\ncase 'pwd':line('out',cwd);break;\ncase 'whoami':line('out','guest (virtual session, not an OS user)');break;\ncase 'date':line('out',new Date().toISOString());break;\ncase 'echo':line('out',args.join(' '));break;\ncase 'tree':line('out',Array.from(fs.keys()).sort().map(p=>p+(fs.get(p)===true&&p!=='/'?'/':'')).join('\\n'));break;\ncase 'ls':{if(args.length>1)throw Error('ls takes at most one directory.');const dir=resolve(args[0]||cwd);if(fs.get(dir)!==true)throw Error('No such directory: '+dir);const prefix=dir==='/'?'/':dir+'/';const names=Array.from(fs.keys()).filter(p=>p.startsWith(prefix)&&p!==dir&&!p.slice(prefix.length).includes('/')).sort().map(p=>p.slice(prefix.length)+(fs.get(p)===true?'/':''));line('out',names.join('  ')||'(empty)');break;}\ncase 'cd':{if(args.length>1)throw Error('cd takes one directory.');const target=resolve(args[0]||'~');if(fs.get(target)!==true)throw Error('No such directory: '+target);cwd=target;showPath();break;}\ncase 'cat':{const p=requireName(args);if(typeof fs.get(p)!=='string')throw Error('Not a file: '+p);line('out',fs.get(p));break;}\ncase 'touch':{const p=requireName(args);if(fs.get(p)===true)throw Error('Not a file: '+p);if(!fs.has(p))fs.set(p,'');break;}\ncase 'mkdir':{const p=requireName(args);if(fs.has(p))throw Error('Path already exists: '+p);fs.set(p,true);break;}\ncase 'rm':{const p=requireName(args);if(!fs.has(p))throw Error('No such file: '+p);if(fs.get(p)===true)throw Error('Not removed: rm supports files only.');fs.delete(p);break;}\ndefault:throw Error(name+': not executed — no OS shell or command runtime is connected.');}\n}catch(error){line('err',error.message);}}\ndocument.querySelector('form').onsubmit=event=>{event.preventDefault();const raw=input.value;input.value='';run(raw);};input.onkeydown=event=>{if(event.key==='ArrowUp'){event.preventDefault();historyIndex=Math.min(history.length-1,historyIndex+1);input.value=history[historyIndex]||'';}else if(event.key==='ArrowDown'){event.preventDefault();historyIndex=Math.max(-1,historyIndex-1);input.value=historyIndex<0?'':history[historyIndex];}};document.getElementById('reset').onclick=reset;reset();\n</script></body></html>\n"
}
